from pathlib import Path
import shutil

from reportlab.lib import colors
from reportlab.lib.enums import TA_CENTER
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
from reportlab.lib.units import mm
from reportlab.platypus import (
    HRFlowable,
    PageBreak,
    Paragraph,
    SimpleDocTemplate,
    Spacer,
    Table,
    TableStyle,
)


ROOT = Path(__file__).resolve().parents[1]
OUTPUT_DIR = ROOT / "output" / "pdf"
BROCHURE_DIR = ROOT / "brochures"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
BROCHURE_DIR.mkdir(parents=True, exist_ok=True)

GREEN = colors.HexColor("#0A3222")
DEEP_GREEN = colors.HexColor("#062217")
GOLD = colors.HexColor("#C5A059")
CREAM = colors.HexColor("#FAF7F2")
TERRACOTTA = colors.HexColor("#A64B34")
INK = colors.HexColor("#243129")
MUTED = colors.HexColor("#68736D")
WHITE = colors.white

styles = getSampleStyleSheet()
styles.add(ParagraphStyle(
    name="CoverKicker",
    parent=styles["Normal"],
    fontName="Helvetica-Bold",
    fontSize=8,
    leading=11,
    textColor=GOLD,
    alignment=TA_CENTER,
    spaceAfter=8,
))
styles.add(ParagraphStyle(
    name="CoverTitle",
    parent=styles["Title"],
    fontName="Times-Bold",
    fontSize=31,
    leading=34,
    textColor=WHITE,
    alignment=TA_CENTER,
    spaceAfter=12,
))
styles.add(ParagraphStyle(
    name="CoverCopy",
    parent=styles["Normal"],
    fontName="Helvetica",
    fontSize=10,
    leading=16,
    textColor=colors.HexColor("#D9E2DD"),
    alignment=TA_CENTER,
))
styles.add(ParagraphStyle(
    name="SectionKicker",
    parent=styles["Normal"],
    fontName="Helvetica-Bold",
    fontSize=7.5,
    leading=10,
    textColor=TERRACOTTA,
    spaceAfter=5,
))
styles.add(ParagraphStyle(
    name="SectionTitle",
    parent=styles["Heading1"],
    fontName="Times-Bold",
    fontSize=23,
    leading=27,
    textColor=GREEN,
    spaceAfter=12,
))
styles.add(ParagraphStyle(
    name="DayTitle",
    parent=styles["Heading2"],
    fontName="Times-Bold",
    fontSize=13,
    leading=16,
    textColor=GREEN,
    spaceAfter=3,
))
styles.add(ParagraphStyle(
    name="BodySmall",
    parent=styles["BodyText"],
    fontName="Helvetica",
    fontSize=8.4,
    leading=12.5,
    textColor=INK,
))
styles.add(ParagraphStyle(
    name="MutedSmall",
    parent=styles["BodyText"],
    fontName="Helvetica",
    fontSize=7.5,
    leading=11,
    textColor=MUTED,
))
styles.add(ParagraphStyle(
    name="CardLabel",
    parent=styles["Normal"],
    fontName="Helvetica-Bold",
    fontSize=7,
    leading=9,
    textColor=GOLD,
))
styles.add(ParagraphStyle(
    name="CardValue",
    parent=styles["Normal"],
    fontName="Times-Bold",
    fontSize=12,
    leading=14,
    textColor=WHITE,
))
styles.add(ParagraphStyle(
    name="FooterNote",
    parent=styles["Normal"],
    fontName="Helvetica",
    fontSize=7.2,
    leading=10,
    textColor=MUTED,
))


def draw_page(canvas, doc):
    canvas.saveState()
    width, height = A4
    if doc.page > 1:
        canvas.setFillColor(DEEP_GREEN)
        canvas.rect(0, height - 14 * mm, width, 14 * mm, stroke=0, fill=1)
        canvas.setFillColor(WHITE)
        canvas.setFont("Times-Bold", 11)
        canvas.drawString(18 * mm, height - 9 * mm, "VISIT KERALA")
        canvas.setFillColor(GOLD)
        canvas.setFont("Helvetica-Bold", 7)
        canvas.drawRightString(width - 18 * mm, height - 9 * mm, doc.title.upper())
    canvas.setStrokeColor(colors.HexColor("#D8DFDB"))
    canvas.line(18 * mm, 15 * mm, width - 18 * mm, 15 * mm)
    canvas.setFillColor(MUTED)
    canvas.setFont("Helvetica", 6.8)
    canvas.drawString(18 * mm, 9 * mm, "Student project, not an official tourism website. Confirm current rates and access.")
    canvas.drawRightString(width - 18 * mm, 9 * mm, f"{doc.page:02d}")
    canvas.restoreState()


def fact_table(items):
    data = [[
        Paragraph(label.upper(), styles["CardLabel"]),
        Paragraph(value, styles["CardValue"]),
    ] for label, value in items]
    table = Table(data, colWidths=[44 * mm, 44 * mm], rowHeights=[15 * mm] * len(data))
    table.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, -1), GREEN),
        ("BOX", (0, 0), (-1, -1), 0.5, colors.HexColor("#456554")),
        ("INNERGRID", (0, 0), (-1, -1), 0.5, colors.HexColor("#456554")),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("LEFTPADDING", (0, 0), (-1, -1), 9),
        ("RIGHTPADDING", (0, 0), (-1, -1), 9),
        ("TOPPADDING", (0, 0), (-1, -1), 6),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 6),
    ]))
    return table


def day_rows(days):
    rows = []
    for index, (title, description, highlights) in enumerate(days, start=1):
        day_number = Paragraph(f"<b>DAY {index:02d}</b>", styles["CardLabel"])
        copy = Paragraph(
            f"<b>{title}</b><br/>{description}<br/><font color='#68736D'>{'  |  '.join(highlights)}</font>",
            styles["BodySmall"],
        )
        rows.append([day_number, copy])
    table = Table(rows, colWidths=[24 * mm, 140 * mm], repeatRows=0)
    table.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (0, -1), GREEN),
        ("TEXTCOLOR", (0, 0), (0, -1), GOLD),
        ("BOX", (0, 0), (-1, -1), 0.55, colors.HexColor("#D6DEDA")),
        ("INNERGRID", (0, 0), (-1, -1), 0.45, colors.HexColor("#D6DEDA")),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ("LEFTPADDING", (0, 0), (-1, -1), 9),
        ("RIGHTPADDING", (0, 0), (-1, -1), 9),
        ("TOPPADDING", (0, 0), (-1, -1), 9),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 9),
    ]))
    return table


def planning_table(title, rows):
    data = [[
        Paragraph("<b>OPTION</b>", styles["SectionKicker"]),
        Paragraph("<b>PLANNING RANGE</b>", styles["SectionKicker"]),
        Paragraph("<b>WHAT IT MEANS</b>", styles["SectionKicker"]),
    ]]
    for label, amount, description in rows:
        data.append([
            Paragraph(f"<b>{label}</b>", styles["BodySmall"]),
            Paragraph(f"<b>{amount}</b>", styles["BodySmall"]),
            Paragraph(description, styles["MutedSmall"]),
        ])
    table = Table(data, colWidths=[42 * mm, 42 * mm, 80 * mm], repeatRows=1)
    table.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), CREAM),
        ("BOX", (0, 0), (-1, -1), 0.55, colors.HexColor("#D6DEDA")),
        ("INNERGRID", (0, 0), (-1, -1), 0.45, colors.HexColor("#D6DEDA")),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ("LEFTPADDING", (0, 0), (-1, -1), 8),
        ("RIGHTPADDING", (0, 0), (-1, -1), 8),
        ("TOPPADDING", (0, 0), (-1, -1), 8),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
    ]))
    return table


def build_brochure(filename, data):
    output_path = OUTPUT_DIR / filename
    doc = SimpleDocTemplate(
        str(output_path),
        pagesize=A4,
        rightMargin=18 * mm,
        leftMargin=18 * mm,
        topMargin=22 * mm,
        bottomMargin=21 * mm,
        title=data["title"],
        author="Visit Kerala",
    )
    story = []

    cover_spacer = Table([[""]], colWidths=[164 * mm], rowHeights=[18 * mm])
    cover_spacer.setStyle(TableStyle([("BACKGROUND", (0, 0), (-1, -1), DEEP_GREEN)]))
    story.extend([
        cover_spacer,
        Table(
            [[
                Paragraph(data["kicker"].upper(), styles["CoverKicker"]),
            ], [
                Paragraph(data["title"], styles["CoverTitle"]),
            ], [
                Paragraph(data["subtitle"], styles["CoverCopy"]),
            ]],
            colWidths=[164 * mm],
            rowHeights=[12 * mm, 37 * mm, 34 * mm],
            style=TableStyle([
                ("BACKGROUND", (0, 0), (-1, -1), DEEP_GREEN),
                ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
                ("LEFTPADDING", (0, 0), (-1, -1), 18),
                ("RIGHTPADDING", (0, 0), (-1, -1), 18),
            ]),
        ),
        Spacer(1, 10 * mm),
        fact_table(data["facts"]),
        Spacer(1, 9 * mm),
        Paragraph("ROUTE AT A GLANCE", styles["SectionKicker"]),
        Paragraph(data["route"], styles["SectionTitle"]),
        Paragraph(data["overview"], styles["BodySmall"]),
        Spacer(1, 7 * mm),
        HRFlowable(width="100%", thickness=1, color=GOLD),
        Spacer(1, 5 * mm),
        Paragraph(data["cover_note"], styles["FooterNote"]),
        PageBreak(),
        Paragraph("DAY BY DAY", styles["SectionKicker"]),
        Paragraph("Five days, clearly paced.", styles["SectionTitle"]),
        day_rows(data["days"]),
        Spacer(1, 7 * mm),
        Paragraph(data["day_note"], styles["FooterNote"]),
        PageBreak(),
        Paragraph("ROUTE PLANNING", styles["SectionKicker"]),
        Paragraph("Who it suits + time on the road.", styles["SectionTitle"]),
        fact_table([("Perfect for", data["audience"]), ("Season guide", "Oct-Mar / Jun-Sep / Apr-May")]),
        Spacer(1, 8 * mm),
        planning_table("Travel", data["travel"]),
        Spacer(1, 8 * mm),
        Paragraph("Travel times are approximate. Traffic, weather, road conditions and stops may change journey times. Coastal and hill conditions can differ, and weather is not guaranteed.", styles["FooterNote"]),
        PageBreak(),
        Paragraph("BUDGET + STAYS", styles["SectionKicker"]),
        Paragraph("Plan the practical details.", styles["SectionTitle"]),
        planning_table("Budget", data["budget"]),
        Spacer(1, 8 * mm),
        Paragraph("POSSIBLE STAYS", styles["SectionKicker"]),
        planning_table("Stays", data["stays"]),
        Spacer(1, 8 * mm),
        Table(
            [[Paragraph(f"<b>BEFORE BOOKING</b><br/>{data['booking_note']}", styles["BodySmall"])]],
            colWidths=[164 * mm],
            style=TableStyle([
                ("BACKGROUND", (0, 0), (-1, -1), CREAM),
                ("BOX", (0, 0), (-1, -1), 0.8, GOLD),
                ("LEFTPADDING", (0, 0), (-1, -1), 12),
                ("RIGHTPADDING", (0, 0), (-1, -1), 12),
                ("TOPPADDING", (0, 0), (-1, -1), 11),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 11),
            ]),
        ),
    ])

    doc.build(story, onFirstPage=draw_page, onLaterPages=draw_page)
    shutil.copy2(output_path, BROCHURE_DIR / filename)
    return output_path


