if __name__ == "__main__":
    for brochure_name, brochure_data in [
        ("kerala-5-day-student-plan.pdf", student),
        ("kerala-5-day-senior-plan.pdf", senior),
    ]:
        print(build_brochure(brochure_name, brochure_data))
